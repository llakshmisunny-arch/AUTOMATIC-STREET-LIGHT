```html
<!DOCTYPE html>
<html>
<head>
    <title>Automatic Street Light</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background: #222;
            color: white;
            padding: 30px;
        }

        h1 {
            color: #ffd700;
        }

        .street {
            margin: 40px auto;
            width: 90%;
            height: 300px;
            background: #555;
            position: relative;
            border-radius: 10px;
        }

        .pole {
            position: absolute;
            width: 10px;
            height: 200px;
            background: #111;
            bottom: 20px;
        }

        .pole1 { left: 20%; }
        .pole2 { left: 50%; }
        .pole3 { left: 80%; }

        .lamp {
            position: absolute;
            width: 35px;
            height: 35px;
            background: #333;
            border-radius: 50%;
            top: -15px;
            left: -12px;
        }

        .on {
            background: yellow;
            box-shadow: 0 0 35px yellow;
        }

        .status {
            font-size: 22px;
            margin: 20px;
        }

        button {
            padding: 12px 25px;
            font-size: 18px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            margin: 5px;
        }

        .night {
            background: #111;
            color: white;
        }

        .day {
            background: #eee;
            color: black;
        }
    </style>
</head>

<body>

    <h1>🌙 Automatic Street Light LED</h1>

    <p>Street lights automatically turn ON during night.</p>

    <div class="status">
        Status: <span id="status">DAY - LED OFF</span>
    </div>

    <div class="street">

        <div class="pole pole1">
            <div class="lamp" id="lamp1"></div>
        </div>

        <div class="pole pole2">
            <div class="lamp" id="lamp2"></div>
        </div>

        <div class="pole pole3">
            <div class="lamp" id="lamp3"></div>
        </div>

    </div>

    <button class="night" onclick="nightMode()">
        🌙 Night Mode
    </button>

    <button class="day" onclick="dayMode()">
        ☀️ Day Mode
    </button>

    <script>

        function nightMode() {

            document.getElementById("lamp1").classList.add("on");
            document.getElementById("lamp2").classList.add("on");
            document.getElementById("lamp3").classList.add("on");

            document.getElementById("status").innerHTML =
                "NIGHT - LED ON";

            document.body.style.background = "#05051a";
        }

        function dayMode() {

            document.getElementById("lamp1").classList.remove("on");
            document.getElementById("lamp2").classList.remove("on");
            document.getElementById("lamp3").classList.remove("on");

            document.getElementById("status").innerHTML =
                "DAY - LED OFF";

            document.body.style.background = "#222";
        }

    </script>

</body>
</html>
```
